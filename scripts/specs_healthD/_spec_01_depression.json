    {
      "title": "识别信号",
      "method": "signs",
      "items": [
        "关注持续情绪低落",
        "留意兴趣减退与疲乏",
        "注意睡眠食欲变化",
        "留意自我贬低念头"
      ]
    },
    {
      "title": "自我关怀",
      "method": "self_care",
      "items": [
