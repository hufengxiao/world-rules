{
  "cat": "health",
  "file": "foot_blister_care",
  "struct": "FootBlisterCareRules",
  "name": "足部水泡与磨伤护理",
  "desc": "久走或运动导致的足部水泡、磨皮的处理与预防",
  "tags": ["健康", "足部", "水泡", "护理", "运动"],
  "category": "RuleCategory::health(\"foot_blister\")",
  "sections": [
    {
      "title": "水泡处理",
      "method": "treat",
      "items": [
        "水泡小者消毒后贴敷保护",
        "大泡用无菌针头刺破引流",
        "破皮处清洗消毒防感染",
        "不硬撕脱落的皮肤"
      ]
    },
    {
      "title": "磨伤护理",
      "method": "care",
      "items": [
        "磨伤处清洗干爽",
        "涂抗菌软膏后包扎",
        "观察有无红肿化脓",
        "愈合期间减少摩擦"
      ]
    },
    {
      "title": "预防",
      "method": "prevention",
      "items": [
        "穿合脚减震的运动鞋",
        "新鞋先磨合再长走",
        "穿吸湿排汗的袜子",
        "长途前涂抹防磨膏"
      ]
    },
    {
      "title": "就医提示",
      "method": "seek",
      "items": [
        "红肿发热伴疼痛加剧就医",
        "糖尿病患者水泡需专业处理",
        "疑有异物嵌入就医移除",
        "伤口长期不愈及时就诊"
      ]
    }
  ]
}