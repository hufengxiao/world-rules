  "name": "日常舒展拉伸",
  "desc": "缓解肌肉紧张、改善柔韧的日常拉伸与活动规则",
  "tags": ["健康", "拉伸", "柔韧", "久坐", "活动"],
  "category": "RuleCategory::health(\"muscle_stretch\")",
