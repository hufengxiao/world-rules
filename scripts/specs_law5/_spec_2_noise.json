{
  "cat": "law",
  "file": "neighborhood_noise_dispute",
  "struct": "NeighborhoodNoiseDisputeRules",
  "name": "邻里噪音纠纷",
  "desc": "处理邻里噪音干扰、沟通与依法维权的要点",
  "origin": "中国",
  "tags": ["法律", "邻里", "噪音", "纠纷"],
  "category": "RuleCategory::law(\"noise_dispute\")",
  "sections": [
    {
      "title": "理性沟通",
      "method": "communicate",
      "items": [
        "先心平气和协商",
        "说明受扰与希望",
        "尊重对方合理作息",
        "互谅避免激化"
      ]
    },
    {
      "title": "记录证据",
      "method": "evidence",
      "items": [
        "记录噪音时间与影响",
        "保留相关沟通记录",
        "必要时记录证据",
        "不虚构夸大情况"
      ]
    },
    {
      "title": "依规处理",
      "method": "channel",
      "items": [
        "物业或社区调解先行",
        "了解噪音管理规定",
        "必要时向部门反映",
        "在合理范围内主张休息权"
      ]
    },
    {
      "title": "依法维权",
      "method": "legal",
      "items": [
        "影响严重可依法主张",
        "避免私报复对骂",
        "依据证据走正当程序",
        "尊重处理结果"
      ]
    }
  ]
}