      "method": "drawing",
      "items": [
        "得墩者先补牌",
        "依次从牌堆摸牌",
        "最后一张将牌归得墩者",
        "补满手牌继续出牌"
      ]
    },
    {
      "title": "计分方式",
      "method": "scoring",
      "items": [
        "A计十一分三点数牌",
        "三牌计十分",
        "K计四分Q计三分J计两分",
        "其余牌不计分"
      ]
    },
    {
      "title": "胜负结束",
      "method": "ending",
      "items": [
        "牌堆与手牌出尽即终局",
        "统计各自赢得的墩内分值",
