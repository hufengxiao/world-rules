{
  "cat": "games",
  "file": "fan_tan",
  "struct": "FanTanRules",
  "name": "番摊",
  "desc": "中国传统猜数博戏，从一堆物品中按四数递减猜余数",
  "origin": "中国",
  "tags": [
    "传统",
    "猜数",
    "博戏"
  ],
  "category": "RuleCategory::games(\"fan_tan\")",
  "sections": [
    {
      "title": "开局布置",
      "method": "setup",
      "items": [
        "庄家备一堆棋子或铜钱",
        "以碗或杯盖住此堆",
        "赌客各自下注押数",
        "押一至四的余数"
      ]
    },
    {
      "title": "开摊计数",
      "method": "counting",
      "items": [
        "庄家揭碗公开棋子",
        "以四枚一组依次拨开",
        "数至最后一组余数",
        "余数即开奖结果"
      ]
    },
    {
      "title": "押注方式",
      "method": "betting",
      "items": [
        "可押单一数字",
        "亦可押角或通吃",
        "押中单一赔付一赔三",
        "不同押法赔率各异"
      ]
    },
    {
      "title": "结算规则",
      "method": "settlement",
      "items": [
        "余数为一至四对应开奖",
        "押中者按赔率取彩",
        "未中者注归庄家",
        "庄家按序完成赔付"
      ]
    },
    {
      "title": "秩序要求",
      "method": "order",
      "items": [
        "开摊前停止下注",
        "计数过程公开透明",
        "不得中途改注",
        "先后顺序由庄家裁定"
      ]
    }
  ]
}
