      "method": "checkin",
      "items": [
        "预留足够时间到机场",
        "按提示有序办理值机",
        "配合安检顺序",
        "取回行李不落失"
      ]
    },
    {
      "title": "候机大厅",
      "method": "lounge",
      "items": [
        "不大声喧哗影响他人",
        "不占座躺卧",
        "手机保持静音接听",
