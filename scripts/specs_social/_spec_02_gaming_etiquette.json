  "name": "在线游戏礼仪",
  "desc": "网络游戏与电竞对局中的文明竞技与交流礼仪",
  "origin": "国际",
  "tags": [
    "社交",
    "礼仪",
    "游戏",
    "电竞",
    "在线"
  ],
  "category": "RuleCategory::social(\"gaming\")",
  "sections": [
    {
      "title": "开局礼仪",
      "method": "start",
      "items": [
        "开局前彼此问好表达尊重",
        "选择角色或线路先沟通",
        "组队时说明自己水平",
        "不对新手嘲讽"
      ]
    },
    {
      "title": "对局中",
      "method": "during",
      "items": [
        "不因失误责骂队友",
        "不发表攻击性歧视言论",
        "不刷屏或恶意挂机",
        "配合团队战术而非一味逞强",
        "不使用外挂与作弊程序"
      ]
    },
    {
      "title": "输赢心态",
      "method": "mindset",
      "items": [
        "输局不抱怨归咎他人",
        "赢局不嘲讽对手",
        "尊重对手的技巧与努力",
        "复盘讨论用平和语气"
      ]
    },
    {
      "title": "团队沟通",
      "method": "communication",
      "items": [
        "使用清晰简洁的指挥提醒",
        "不一失误就否定队友",
        "佩戴耳机不打扰他人",
        "鼓励新手并耐心指导"
      ]
    }
  ]
}