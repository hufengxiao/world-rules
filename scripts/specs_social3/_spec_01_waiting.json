{
  "cat": "social",
  "file": "waiting_room_etiquette",
  "struct": "WaitingRoomEtiquetteRules",
  "name": "等候室与候诊礼仪",
  "desc": "医院候诊室、服务窗口等候区等的秩序与安静礼仪",
  "tags": ["社交", "礼仪", "候诊", "等候", "医院"],
  "category": "RuleCategory::social(\"waiting_room\")",
  "sections": [
    {
      "title": "排队秩序",
      "method": "queue",
      "items": [
        "按规定依次排队取号",
        "不插队不代排越多人",
        "尊重叫号次序",
        "需要帮助的老弱可礼貌请求优先"
      ]
    },
    {
      "title": "保持安静",
      "method": "quiet",
      "items": [
        "候诊时保持安静",
        "接打电话到外压低音量",
        "不围观他人就诊信息",
        "照顾儿童不使其喧闹"
      ]
    },
    {
      "title": "尊重他人",
      "method": "respect",
      "items": [
        "不随意评论他人病情",
        "为携带婴儿者让座",
        "不探听他人就医隐私",
        "理解医护接待顺序"
      ]
    },
    {
      "title": "环境卫生",
      "method": "hygiene",
      "items": [
        "不随意丢弃垃圾",
        "咳嗽喷嚏用手肘遮挡",
        "症状急重者及时告知前台",
        "离开带走随身物品"
      ]
    }
  ]
}