{
  "cat": "health",
  "file": "ear_wax_care",
  "struct": "EarWaxCareRules",
  "name": "耳垢护理",
  "desc": "耳垢的正常处理与耳道清洁禁忌",
  "origin": "中国",
  "tags": [
    "五官",
    "耳道",
    "护理"
  ],
  "category": "RuleCategory::health(\"ear_wax_care\")",
  "sections": [
    {
      "title": "正确认识",
      "method": "understanding",
      "items": [
        "耳垢有保护耳道作用",
        "多可随咀嚼自行排出",
        "并非越干净越好",
        "无需频繁清理"
      ]
    },
    {
      "title": "清理禁忌",
      "method": "avoid",
      "items": [
        "勿用棉签深入掏耳",
        "勿用发卡牙签等硬物",
        "勿过度频繁掏耳",
        "避免用力捅伤鼓膜"
      ]
    },
    {
      "title": "日常护理",
      "method": "daily_care",
      "items": [
        "外耳廓用湿巾擦拭即可",
        "洗澡后倾头排出积水",
        "游泳戴耳塞防进水",
        "保持耳道干燥"
      ]
    },
    {
      "title": "就医提示",
      "method": "seeking_help",
      "items": [
        "耳垢堵塞听力下降就医",
        "耳痛耳闷应及时就诊",
        "耳道流液流脓须就医",
        "由专业人员取出耳垢"
      ]
    }
  ]
}
