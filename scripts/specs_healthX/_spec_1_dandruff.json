{
  "cat": "health",
  "file": "dandruff_scalp_care",
  "struct": "DandruffScalpCareRules",
  "name": "头皮屑护理",
  "desc": "头皮屑与头皮瘙痒的清洁与日常养护",
  "origin": "中国",
  "tags": [
    "皮肤",
    "头皮",
    "护理"
  ],
  "category": "RuleCategory::health(\"dandruff_scalp_care\")",
  "sections": [
    {
      "title": "清洁方法",
      "method": "cleaning",
      "items": [
        "温水洗发勿用过热",
        "洗发水充分起泡再上头",
        "指腹按摩头皮勿用指甲抓",
        "冲洗彻底不留残留"
      ]
    },
    {
      "title": "洗发频率",
      "method": "frequency",
      "items": [
        "油性头皮可隔日一洗",
        "干性头皮不宜过勤",
        "出汗后及时清洁",
        "依头皮状况调整"
      ]
    },
    {
      "title": "去屑护理",
      "method": "treatment",
      "items": [
        "可选含去屑成分洗发水",
        "去屑产品需停留数分钟",
        "交替使用防耐受",
        "坚持一段时间见效"
      ]
    },
    {
      "title": "生活调整",
      "method": "lifestyle",
      "items": [
        "规律作息少熬夜",
        "清淡饮食少油腻辛辣",
        "减少烫染刺激头皮",
        "枕巾毛巾勤换洗"
      ]
    }
  ]
}
