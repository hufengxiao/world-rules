{
  "cat": "health",
  "file": "vertigo_rehab_balance",
  "struct": "VertigoRehabBalanceRules",
  "name": "眩晕与平衡康复",
  "desc": "眩晕症状的日常管理与平衡康复规则，包括体位调整、前庭康复训练、环境安全与就医评估，减少跌倒风险。",
  "origin": "神经内科与前庭康复医学建议",
  "tags": [
    "健康",
    "眩晕",
    "平衡",
    "康复"
  ],
  "category": "RuleCategory::health(\"vertigo\")",
  "sections": [
    {
      "title": "发作应对",
      "method": "response",
      "items": [
        "发作时立即坐下或躺下",
        "闭眼静卧减少头部转动",
        "缓慢改变体位不猛然起身",
        "避免独自登高或驾车"
      ]
    },
    {
      "title": "平衡训练",
      "method": "training",
      "items": [
        "循序渐进做前庭康复操",
        "练习单脚站立提升平衡",
        "扶稳物体再逐步放手",
        "量力而行不勉强"
      ]
    },
    {
      "title": "环境安全",
      "method": "safety",
      "items": [
        "居家通道保持通畅",
        "浴室铺设防滑垫",
        "夜间留小灯防跌倒",
        "常用物品置于易取处"
      ]
    },
    {
      "title": "就医评估",
      "method": "medical",
      "items": [
        "反复眩晕须专科检查",
        "伴耳鸣听力下降尽早就诊",
        "突发剧烈眩晕伴肢体无力急诊",
        "遵医嘱用药与复诊"
      ]
    }
  ]
}