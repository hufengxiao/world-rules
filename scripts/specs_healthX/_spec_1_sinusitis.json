{
  "cat": "health",
  "file": "sinusitis_care",
  "struct": "SinusitisCareRules",
  "name": "鼻窦炎护理",
  "desc": "鼻窦炎的日常护理与缓解规则，包括鼻腔冲洗、湿度调节、休息营养与就医指征，减轻鼻塞头痛等不适。",
  "origin": "耳鼻喉科临床护理与家庭护理建议",
  "tags": [
    "健康",
    "鼻腔",
    "炎症",
    "护理"
  ],
  "category": "RuleCategory::health(\"sinusitis\")",
  "sections": [
    {
      "title": "鼻腔护理",
      "method": "nasal_care",
      "items": [
        "用生理盐水冲洗鼻腔",
        "保持鼻腔湿润不干燥",
        "正确擤鼻避免用力过猛",
        "避免挖鼻损伤黏膜"
      ]
    },
    {
      "title": "环境调节",
      "method": "environment",
      "items": [
        "室内保持适当湿度",
        "避免冷空气直吹",
        "远离烟雾与粉尘刺激",
        "保持空气流通"
      ]
    },
    {
      "title": "休息营养",
      "method": "rest",
      "items": [
        "保证充足睡眠",
        "多饮温水稀释分泌物",
        "饮食清淡少辛辣",
        "热敷面部缓解胀痛"
      ]
    },
    {
      "title": "就医指征",
      "method": "medical",
      "items": [
        "症状超过一周未缓解须就诊",
        "高热或剧烈头痛及时就医",
        "面部肿胀视力异常速诊",
        "遵医嘱用药不滥用抗生素"
      ]
    }
  ]
}