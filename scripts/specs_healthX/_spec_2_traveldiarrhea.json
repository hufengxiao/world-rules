{
  "cat": "health",
  "file": "traveler_diarrhea_care",
  "struct": "TravelerDiarrheaCareRules",
  "name": "旅行者腹泻应对",
  "desc": "外出旅行时腹泻的预防与应对规则，包括饮食饮水安全、补液、用药分寸与就医判断，保障旅途健康。",
  "origin": "旅行医学与感染科防护建议",
  "tags": [
    "健康",
    "旅行",
    "腹泻",
    "防护"
  ],
  "category": "RuleCategory::health(\"traveler_diarrhea\")",
  "sections": [
    {
      "title": "预防要点",
      "method": "prevention",
      "items": [
        "饮用瓶装或煮沸的水",
        "不吃生冷未熟食物",
        "水果去皮后食用",
        "饭前便后洗手"
      ]
    },
    {
      "title": "补液护理",
      "method": "hydration",
      "items": [
        "及时补充口服补液盐",
        "少量多次饮水",
        "避免含糖过高饮料",
        "注意电解质平衡"
      ]
    },
    {
      "title": "饮食调整",
      "method": "diet",
      "items": [
        "暂食清淡易消化食物",
        "避免油腻乳制品",
        "少量多餐减轻肠胃负担",
        "症状缓解后逐步恢复"
      ]
    },
    {
      "title": "用药与就医",
      "method": "medical",
      "items": [
        "备好常用止泻药物",
        "按说明用药不滥用抗生素",
        "高热血便脱水须就医",
        "症状持续超三天及时就诊"
      ]
    }
  ]
}