{
  "cat": "health",
  "file": "prostate_health_basic",
  "struct": "ProstateHealthBasicRules",
  "name": "前列腺保健",
  "desc": "中老年男性前列腺健康的日常保健规则，涵盖饮食、运动、排尿习惯与定期筛查，帮助预防前列腺增生与相关疾病。",
  "origin": "泌尿外科与老年男性健康管理建议",
  "tags": [
    "健康",
    "男性",
    "前列腺",
    "保健"
  ],
  "category": "RuleCategory::health(\"prostate\")",
  "sections": [
    {
      "title": "饮食调理",
      "method": "diet",
      "items": [
        "多吃番茄等富含番茄红素食物",
        "适量坚果与深海鱼",
        "少辛辣与高脂饮食",
        "戒烟限酒"
      ]
    },
    {
      "title": "生活运动",
      "method": "lifestyle",
      "items": [
        "避免久坐定时起身活动",
        "适度有氧运动改善循环",
        "注意下身保暖",
        "规律作息减少劳累"
      ]
    },
    {
      "title": "排尿习惯",
      "method": "voiding",
      "items": [
        "不憋尿及时排空膀胱",
        "睡前适量饮水减少夜尿",
        "避免过量饮酒与浓茶",
        "留意排尿是否顺畅"
      ]
    },
    {
      "title": "筛查就医",
      "method": "medical",
      "items": [
        "中年起定期体检筛查",
        "尿频尿急尿不尽须就诊",
        "血尿或排尿疼痛立即就医",
        "遵医嘱复查不自行停药"
      ]
    }
  ]
}