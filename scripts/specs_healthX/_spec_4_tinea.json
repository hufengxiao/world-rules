{
  "cat": "health",
  "file": "tinea_pedis_care",
  "struct": "TineaPedisCareRules",
  "name": "足癣（脚气）护理",
  "desc": "足癣的日常护理与防复发规则，包括保持足部干燥、鞋袜处理、规范用药与防止交叉感染，避免反复发作。",
  "origin": "皮肤科真菌感染防治建议",
  "tags": [
    "健康",
    "皮肤",
    "真菌",
    "护理"
  ],
  "category": "RuleCategory::health(\"tinea_pedis\")",
  "sections": [
    {
      "title": "保持干燥",
      "method": "dryness",
      "items": [
        "洗脚后彻底擦干趾缝",
        "选择透气鞋袜",
        "出汗多时及时更换袜子",
        "避免长时间穿闷热鞋"
      ]
    },
    {
      "title": "鞋袜处理",
      "method": "footwear",
      "items": [
        "鞋袜勤换勤洗",
        "阳光下晾晒杀菌",
        "不与他人共用拖鞋毛巾",
        "可定期消毒鞋内"
      ]
    },
    {
      "title": "规范用药",
      "method": "medication",
      "items": [
        "遵医嘱坚持外用抗真菌药",
        "症状消失后继续巩固疗程",
        "不随意停药防复发",
        "不滥用激素类药膏"
      ]
    },
    {
      "title": "防交叉感染",
      "method": "prevention",
      "items": [
        "公共场所不光脚行走",
        "指甲剪短避免抓挠传播",
        "手部接触患处后洗手",
        "家人同患需一同治疗"
      ]
    }
  ]
}