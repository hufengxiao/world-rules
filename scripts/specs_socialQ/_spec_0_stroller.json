    "育儿",
    "礼仪"
  ],
  "category": "RuleCategory::social(\"stroller\")",
  "sections": [
    {
      "title": "通行礼让",
      "method": "passing",
      "items": [
        "狭窄通道主动礼让行人",
        "不占据通道长时间停留",
        "进出门口让他人先行",
        "人多处减速慢行"
      ]
    },
    {
      "title": "公共交通",
      "method": "transit",
      "items": [
        "上下车先收折或避让",
        "不妨碍车门与通道",
        "乘坐扶梯优先选直梯",
        "遇拥挤耐心等候下一班"
      ]
    },
    {
      "title": "电梯使用",
      "method": "elevator",
      "items": [
        "推车进电梯先打招呼",
        "尽量靠边不挡按键",
        "让出行人空间",
        "进出先确认安全"
      ]
    },
    {
      "title": "安全与体谅",
      "method": "safety",
      "items": [
        "系好安全带防止跌落",
        "不将婴儿车停在楼梯口",
        "注意车轮不碾压他人",
        "对让路者道谢"
      ]
    }
  ]
