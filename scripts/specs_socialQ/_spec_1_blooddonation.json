{
  "cat": "social",
  "file": "blood_donation_etiquette",
  "struct": "BloodDonationEtiquetteRules",
  "name": "献血礼仪",
  "desc": "参与无偿献血的礼节与配合规则，包括现场秩序、如实告知健康状况、配合采血与献血后休养，营造友善的公益氛围。",
  "origin": "无偿献血公益活动中的常见场景",
  "tags": [
    "社交",
    "公益",
    "献血",
    "礼仪"
  ],
  "category": "RuleCategory::social(\"blood_donation\")",
  "sections": [
    {
      "title": "现场秩序",
      "method": "order",
      "items": [
        "按号排队耐心等候",
        "保持安静不喧哗",
        "听从工作人员指引",
        "不插队不催促"
      ]
    },
    {
      "title": "健康告知",
      "method": "disclosure",
      "items": [
        "如实填写健康状况",
        "不隐瞒疾病与用药史",
        "近期不适主动说明",
        "对自身与他人负责"
      ]
    },
    {
      "title": "采血配合",
      "method": "cooperation",
      "items": [
        "放松心情配合操作",
        "穿刺时保持手臂不动",
        "不适及时告知医护",
        "献完按压止血片刻"
      ]
    },
    {
      "title": "献血之后",
      "method": "aftercare",
      "items": [
        "静坐休息再起身",
        "当日避免剧烈运动",
        "适当补充水分营养",
        "对医护人员道谢"
      ]
    }
  ]
}