{
  "cat": "social",
  "file": "parent_teacher_meeting",
  "struct": "ParentTeacherMeetingRules",
  "name": "家长会沟通礼仪",
  "desc": "参加家长会与老师沟通的礼仪规则，包括守时、尊重、理性沟通与家校配合，共同促进孩子成长。",
  "origin": "家校共育场景中的常见沟通礼仪",
  "tags": [
    "社交",
    "教育",
    "家校",
    "礼仪"
  ],
  "category": "RuleCategory::social(\"parent_teacher\")",
  "sections": [
    {
      "title": "会前准备",
      "method": "preparation",
      "items": [
        "按时到场不迟到",
        "提前了解孩子在校情况",
        "梳理想沟通的问题",
        "手机调至静音"
      ]
    },
    {
      "title": "沟通态度",
      "method": "attitude",
      "items": [
        "尊重老师的专业判断",
        "耐心倾听不打断",
        "就事论事不指责",
        "不攀比不抱怨"
      ]
    },
    {
      "title": "交流内容",
      "method": "communication",
      "items": [
        "客观反映孩子在家表现",
        "重点询问具体改进建议",
        "不只听成绩也关注身心",
        "有疑问平和求证"
      ]
    },
    {
      "title": "家校配合",
      "method": "cooperation",
      "items": [
        "认同老师合理要求",
        "在家配合落实教育方法",
        "保持长期沟通渠道",
        "会后向孩子转达关怀"
      ]
    }
  ]
}