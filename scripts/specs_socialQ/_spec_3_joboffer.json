{
  "cat": "social",
  "file": "job_offer_negotiation_etiquette",
  "struct": "JobOfferNegotiationEtiquetteRules",
  "name": "谈录用与入职礼仪",
  "desc": "收到录用通知后沟通与入职的礼仪规则，包括及时回应、诚恳谈条件、诚信守约与入职报到礼节，维护职业形象。",
  "origin": "职场求职与录用沟通场景",
  "tags": [
    "社交",
    "职场",
    "求职",
    "礼仪"
  ],
  "category": "RuleCategory::social(\"job_offer\")",
  "sections": [
    {
      "title": "及时回应",
      "method": "response",
      "items": [
        "收到通知尽快答复",
        "考虑期内主动沟通进度",
        "不拖延占用他人名额",
        "婉拒也须礼貌说明"
      ]
    },
    {
      "title": "谈条件",
      "method": "negotiation",
      "items": [
        "在合理范围提出诉求",
        "语气诚恳态度专业",
        "不过度讨价还价",
        "达成的条件书面确认"
      ]
    },
    {
      "title": "诚信守约",
      "method": "integrity",
      "items": [
        "答应入职不随意反悔",
        "确实变卦尽早告知",
        "不脚踏多船隐瞒实情",
        "尊重双方时间成本"
      ]
    },
    {
      "title": "入职报到",
      "method": "onboarding",
      "items": [
        "按时报到不迟到",
        "备齐所需材料",
        "主动向同事自我介绍",
        "对接待者表示感谢"
      ]
    }
  ]
}