{
  "cat": "social",
  "file": "family_reunion_dinner_etiquette",
  "struct": "FamilyReunionDinnerEtiquetteRules",
  "name": "家庭聚餐礼仪",
  "desc": "一家人团聚用餐时的座次与相处礼节",
  "origin": "中国",
  "tags": [
    "家庭",
    "聚餐",
    "礼仪"
  ],
  "category": "RuleCategory::social(\"family_reunion_dinner_etiquette\")",
  "sections": [
    {
      "title": "座次安排",
      "method": "seating",
      "items": [
        "长辈居主位",
        "长者上座晚辈下座",
        "夫妻可相邻而坐",
        "让位给来客"
      ]
    },
    {
      "title": "用餐礼节",
      "method": "dining",
      "items": [
        "长者先动筷",
        "为长辈夹菜添饭",
        "吃饭不出声不挑拣",
        "公筷公勺讲卫生"
      ]
    },
    {
      "title": "交谈分寸",
      "method": "conversation",
      "items": [
        "多聊家常少揭短",
        "不谈令人不快话题",
        "尊重各人选择",
        "不当众攀比议论"
      ]
    },
    {
      "title": "晚辈之道",
      "method": "junior_duty",
      "items": [
        "主动帮忙张罗",
        "照顾老人小孩",
        "饭后帮忙收拾",
        "离席道别致谢"
      ]
    }
  ]
}
