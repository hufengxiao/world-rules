  "sections": [
    {
      "title": "用药管理",
      "method": "medication",
      "items": [
        "严格按时按量服药",
        "不可自行增减或停药",
        "记录药效波动情况",
        "定期复诊调整方案"
      ]
    },
    {
      "title": "运动康复",
      "method": "exercise",
      "items": [
        "坚持适度关节活动训练",
        "练习平衡与步态改善",
        "做面部与言语练习",
        "量力而行循序渐进"
      ]
    },
    {
      "title": "居家安全",
      "method": "safety",
      "items": [
        "通道通畅移除绊脚物",
        "浴室加装扶手防跌倒",
        "穿防滑鞋避免拖鞋",
        "起步转身放慢动作"
      ]
    },
    {
      "title": "情绪与支持",
      "method": "support",
      "items": [
        "耐心沟通不催促",
        "鼓励参与社交活动",
        "关注情绪变化防抑郁",
        "家属学习照护知识"
      ]
    }
  ]
