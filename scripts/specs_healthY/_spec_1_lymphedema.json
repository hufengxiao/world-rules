{
  "cat": "health",
  "file": "lymphedema_care",
  "struct": "LymphedemaCareRules",
  "name": "淋巴水肿护理",
  "desc": "淋巴水肿的日常护理规则，包括抬高患肢、皮肤保护、压力治疗与适度活动，帮助减轻肿胀并预防感染。",
  "origin": "康复医学与淋巴水肿专科护理建议",
  "tags": [
    "健康",
    "淋巴",
    "水肿",
    "护理"
  ],
  "category": "RuleCategory::health(\"lymphedema\")",
  "sections": [
    {
      "title": "肢体护理",
      "method": "limb_care",
      "items": [
        "抬高患肢促进回流",
        "避免患肢长时间下垂",
        "穿宽松衣物不勒紧",
        "避免患肢测量血压或抽血"
      ]
    },
    {
      "title": "皮肤保护",
      "method": "skin_care",
      "items": [
        "保持皮肤清洁滋润",
        "防止蚊虫叮咬与划伤",
        "伤口及时消毒处理",
        "留意红肿热痛感染信号"
      ]
    },
    {
      "title": "压力治疗",
      "method": "compression",
      "items": [
        "遵医嘱穿戴压力袖套或袜",
        "白天佩戴夜间按需取下",
        "定期更换保持弹力",
        "配合专业淋巴引流按摩"
      ]
    },
    {
      "title": "活动与就医",
      "method": "activity",
      "items": [
        "适度活动促进淋巴循环",
        "循序渐进不突然剧烈运动",
        "肿胀加重须及时就诊",
        "定期复查调整方案"
      ]
    }
  ]
}