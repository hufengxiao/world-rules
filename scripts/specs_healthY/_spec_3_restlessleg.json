{
  "cat": "health",
  "file": "restless_leg_care",
  "struct": "RestlessLegCareRules",
  "name": "不宁腿缓解",
  "desc": "不宁腿综合征的日常缓解与调理规则，包括作息规律、适度活动、饮食调整与就医评估，改善夜间腿部不适。",
  "origin": "神经内科睡眠障碍相关健康建议",
  "tags": [
    "健康",
    "睡眠",
    "腿部",
    "调理"
  ],
  "category": "RuleCategory::health(\"restless_leg\")",
  "sections": [
    {
      "title": "作息调理",
      "method": "routine",
      "items": [
        "保持规律作息与睡眠时间",
        "睡前放松避免过度兴奋",
        "营造安静舒适的睡眠环境",
        "避免熬夜加重症状"
      ]
    },
    {
      "title": "活动缓解",
      "method": "activity",
      "items": [
        "发作时起身走动缓解",
        "适度拉伸小腿肌肉",
        "睡前温水泡脚放松",
        "白天规律运动但避免睡前剧烈"
      ]
    },
    {
      "title": "饮食注意",
      "method": "diet",
      "items": [
        "减少咖啡因与酒精摄入",
        "睡前避免浓茶咖啡",
        "注意铁与叶酸营养",
        "均衡饮食不偏食"
      ]
    },
    {
      "title": "就医评估",
      "method": "medical",
      "items": [
        "症状频繁影响睡眠须就诊",
        "排查缺铁或慢性疾病",
        "遵医嘱用药不自行加量",
        "记录发作规律便于诊疗"
      ]
    }
  ]
}