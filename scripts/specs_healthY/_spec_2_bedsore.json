{
  "cat": "health",
  "file": "bed_sore_prevention",
  "struct": "BedSorePreventionRules",
  "name": "压疮（褥疮）预防",
  "desc": "长期卧床者压疮的预防与护理规则，包括定时翻身、皮肤护理、减压用具与营养支持，降低皮肤破损风险。",
  "origin": "老年护理与临床压疮防治指南",
  "tags": [
    "健康",
    "护理",
    "卧床",
    "预防"
  ],
  "category": "RuleCategory::health(\"bed_sore\")",
  "sections": [
    {
      "title": "体位变换",
      "method": "positioning",
      "items": [
        "定时协助翻身变换体位",
        "骨突部位避免持续受压",
        "使用软枕垫托支撑",
        "坐位者也要定时减压"
      ]
    },
    {
      "title": "皮肤护理",
      "method": "skin_care",
      "items": [
        "保持皮肤清洁干燥",
        "大小便后及时清理",
        "避免用力拖拽摩擦皮肤",
        "观察发红处勿按摩破损区"
      ]
    },
    {
      "title": "减压用具",
      "method": "support",
      "items": [
        "使用气垫床或减压垫",
        "床单平整无褶皱",
        "衣物宽松无硬物",
        "保持床铺清洁干爽"
      ]
    },
    {
      "title": "营养与观察",
      "method": "nutrition",
      "items": [
        "保证蛋白质与维生素摄入",
        "适量饮水保持皮肤弹性",
        "每日检查受压部位皮肤",
        "出现破溃及时就医处理"
      ]
    }
  ]
}