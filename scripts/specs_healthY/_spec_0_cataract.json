{
  "cat": "health",
  "file": "cataract_post_op_care",
  "struct": "CataractPostOpCareRules",
  "name": "白内障术后护理",
  "desc": "白内障手术后的眼部护理与康复规则，包括用眼卫生、滴眼药规范、避免外力与复查安排，保障术后视力恢复。",
  "origin": "眼科术后护理与康复指导",
  "tags": [
    "健康",
    "眼科",
    "术后",
    "护理"
  ],
  "category": "RuleCategory::health(\"cataract\")",
  "sections": [
    {
      "title": "用眼卫生",
      "method": "hygiene",
      "items": [
        "术后勿揉眼按压眼球",
        "洗头洗脸避免水入眼",
        "外出戴防护镜遮光",
        "保持眼部清洁"
      ]
    },
    {
      "title": "用药规范",
      "method": "medication",
      "items": [
        "按时按量滴眼药水",
        "滴药前洗净双手",
        "多种眼药间隔数分钟",
        "遵医嘱不自行停药"
      ]
    },
    {
      "title": "活动限制",
      "method": "activity",
      "items": [
        "避免剧烈运动与弯腰用力",
        "不提重物防眼压升高",
        "睡觉勿压患侧眼",
        "咳嗽便秘须及时缓解"
      ]
    },
    {
      "title": "复查与预警",
      "method": "medical",
      "items": [
        "按医嘱定期复查视力",
        "眼痛视力骤降立即就医",
        "眼红分泌物增多须复诊",
        "按时取出或调整眼罩"
      ]
    }
  ]
}