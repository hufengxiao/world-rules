  "name": "探访病人",
  "desc": "探访病人的时机、交谈与礼貌分寸",
  "tags": ["社交", "探病", "探望", "病房"],
  "origin": "中国",
  "category": "RuleCategory::social(\"visit_patient\")",
  "sections": [
    {
      "title": "择时前往",
      "method": "timing",
      "items": [
        "先联系家人问时间",
        "避开治疗休息",
        "时长不宜太长",
        "身体不适缓去"
      ]
    },
    {
      "title": "询问体贴",
            "method": "words",
            "items": [
              "说宽慰的话",
              "不问病况隐私",
              "不多谈病情担忧",
              "多陪伴少谈忧"
            ]
    },
    {
      "title": "带礼合适",
      "method": "gift",
      "items": [
        "带水果或鲜花",
        "先问忌口如实",
        "食物携带合适",
        "心意为主"
      ]
    },
    {
      "title": "顾及休养",
      "method": "respect",
      "items": [
        "轻声细语",
        "坐一会即辞",
        "不打扰休息","祝福康复"
      ]
    }
  ]
}