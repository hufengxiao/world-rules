{
  "cat": "social",
  "file": "park_etiquette",
  "struct": "ParkEtiquetteRules",
  "name": "公园公共礼仪",
  "desc": "公园、绿地等公共休闲空间的共享、环保与礼仪规范",
  "origin": "公共",
  "tags": ["社交", "礼仪", "公园", "绿地", "环保"],
  "category": "RuleCategory::social(\"park\")",
  "sections": [
    {
      "title": "共享空间",
      "method": "share",
      "items": [
        "不长时间独占整张长凳",
        "运动器材轮换使用不霸占",
        "放风筝等避开他人与电线",
        "照顾老弱不占开阔步道"
      ]
    },
    {
      "title": "噪音与宠物",
      "method": "noise",
      "items": [
        "控制外放音响的音量",
        "宠物牵绳并及时清理粪便",
        "儿童嬉闹看护好不撞人",
        "广场舞等音量不影响他人"
      ]
    },
    {
      "title": "环境卫生",
      "method": "cleanliness",
      "items": [
        "垃圾按分类投放桶内",
        "不践踏花坛与禁入草坪",
        "不在非吸烟区吸烟",
        "爱护花草树木不折枝"
      ]
    },
    {
      "title": "公共设施",
      "method": "facilities",
      "items": [
        "洗手间接序使用",
        "游乐设施排队依序",
        "不损坏雕塑喷泉等设施",
        "用后归还原位的公共物品"
      ]
    }
  ]
}