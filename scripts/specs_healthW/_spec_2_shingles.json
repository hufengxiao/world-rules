{
  "cat": "health",
  "file": "shingles_zoster_care",
  "struct": "ShinglesZosterCareRules",
  "name": "带状疱疹护理",
  "desc": "带状疱疹的护理与康复规则，包括皮疹护理、疼痛管理、休息营养与预防后遗神经痛，强调尽早规范治疗。",
  "origin": "皮肤科与神经内科临床护理建议",
  "tags": [
    "健康",
    "皮肤",
    "疱疹",
    "神经痛"
  ],
  "category": "RuleCategory::health(\"shingles\")",
  "sections": [
    {
      "title": "皮疹护理",
      "method": "skin_care",
      "items": [
        "保持患处清洁干燥",
        "勿抓挠或挑破水疱",
        "穿宽松棉质衣物减少摩擦",
        "遵医嘱外用药物"
      ]
    },
    {
      "title": "疼痛管理",
      "method": "pain",
      "items": [
        "按医嘱使用止痛或抗病毒药",
        "早期用药降低后遗神经痛",
        "冷敷缓解灼痛不适",
        "避免劳累诱发疼痛加重"
      ]
    },
    {
      "title": "休息营养",
      "method": "rest",
      "items": [
        "保证充足睡眠",
        "饮食清淡易消化",
        "补充蛋白质与维生素",
        "避免辛辣刺激与饮酒"
      ]
    },
    {
      "title": "就医与预防",
      "method": "medical",
      "items": [
        "出疹七十二小时内尽早就医",
        "眼部或耳部受累须专科处理",
        "疼痛持续超一月需复诊",
        "适龄人群可接种疫苗预防"
      ]
    }
  ]
}