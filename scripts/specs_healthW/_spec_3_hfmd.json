{
  "cat": "health",
  "file": "hand_foot_mouth_care",
  "struct": "HandFootMouthCareRules",
  "name": "手足口病护理",
  "desc": "儿童手足口病的家庭护理与隔离防护规则，包括口腔与皮疹护理、饮食调整、消毒隔离及重症预警识别。",
  "origin": "儿科与疾控传染病防控建议",
  "tags": [
    "健康",
    "儿童",
    "传染病",
    "护理"
  ],
  "category": "RuleCategory::health(\"hfmd\")",
  "sections": [
    {
      "title": "隔离防护",
      "method": "isolation",
      "items": [
        "发病期居家隔离避免接触他人",
        "玩具餐具单独使用并消毒",
        "照护者勤洗手",
        "症状消失后仍需观察数日"
      ]
    },
    {
      "title": "口腔护理",
      "method": "oral",
      "items": [
        "饭后温水漱口保持清洁",
        "口腔溃疡可涂护创药物",
        "避免酸辣烫等刺激食物",
        "少量多次喂温水"
      ]
    },
    {
      "title": "皮疹护理",
      "method": "skin_care",
      "items": [
        "保持皮肤清洁干燥",
        "剪短指甲防止抓破",
        "穿柔软宽松衣物",
        "疱疹破溃处防感染"
      ]
    },
    {
      "title": "饮食与预警",
      "method": "diet",
      "items": [
        "给温凉流质或软食",
        "避免坚硬粗糙食物",
        "持续高热精神差须就医",
        "出现惊跳肢体抖动立即急诊"
      ]
    }
  ]
}