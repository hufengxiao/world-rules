{
  "cat": "health",
  "file": "gallstone_biliary_care",
  "struct": "GallstoneBiliaryCareRules",
  "name": "胆囊结石护理",
  "desc": "胆囊结石与胆道健康的日常调理规则，涵盖低脂饮食、规律进餐、体重管理与症状识别，减少胆绞痛发作风险。",
  "origin": "消化内科与肝胆外科临床建议",
  "tags": [
    "健康",
    "胆囊",
    "结石",
    "饮食"
  ],
  "category": "RuleCategory::health(\"gallstone\")",
  "sections": [
    {
      "title": "饮食原则",
      "method": "diet",
      "items": [
        "控制脂肪与胆固醇摄入",
        "少食油炸肥腻食物",
        "多吃蔬菜与膳食纤维",
        "适量优质蛋白"
      ]
    },
    {
      "title": "进餐规律",
      "method": "meal",
      "items": [
        "三餐定时不长时间空腹",
        "早餐不可省略",
        "避免暴饮暴食",
        "少量多餐减轻胆囊负担"
      ]
    },
    {
      "title": "生活管理",
      "method": "lifestyle",
      "items": [
        "控制体重避免快速减肥",
        "适度运动促进代谢",
        "保持情绪平稳",
        "规律作息不熬夜"
      ]
    },
    {
      "title": "症状与就医",
      "method": "medical",
      "items": [
        "右上腹疼痛放射至肩背",
        "进食油腻后腹胀恶心",
        "出现黄疸或高热须急诊",
        "定期超声复查结石变化"
      ]
    }
  ]
}