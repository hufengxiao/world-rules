{
  "cat": "health",
  "file": "heartburn_reflux",
  "struct": "HeartburnRefluxRules",
  "name": "烧心反酸护理",
  "desc": "胃酸反流引起烧心反酸的日常缓解与防护",
  "origin": "中国",
  "tags": [
    "消化",
    "胃酸",
    "护理"
  ],
  "category": "RuleCategory::health(\"heartburn_reflux\")",
  "sections": [
    {
      "title": "饮食规避",
      "method": "avoid",
      "items": [
        "少食巧克力咖啡浓茶",
        "避免过酸过辣食物",
        "减少高脂油炸摄入",
        "忌饱餐后立即平卧"
      ]
    },
    {
      "title": "餐后护理",
      "method": "after_meal",
      "items": [
        "餐后保持直立两小时",
        "睡前两三小时不进食",
        "抬高床头十至十五厘米",
        "左侧卧有助减少反流"
      ]
    },
    {
      "title": "生活调整",
      "method": "lifestyle",
      "items": [
        "控制体重减轻腹压",
        "松解过紧的腰带衣物",
        "戒烟限酒保护贲门",
        "避免弯腰用力动作"
      ]
    },
    {
      "title": "就医警示",
      "method": "warning",
      "items": [
        "频繁发作须就医评估",
        "吞咽困难体重下降就诊",
        "胸痛需先排除心脏问题",
        "长期反流防食管病变"
      ]
    }
  ]
}
