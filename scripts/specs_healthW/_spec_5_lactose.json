{
  "cat": "health",
  "file": "lactose_intolerance_care",
  "struct": "LactoseIntoleranceCareRules",
  "name": "乳糖不耐受护理",
  "desc": "乳糖不耐受人群的饮食替代与营养补充要点",
  "origin": "中国",
  "tags": [
    "消化",
    "乳糖",
    "饮食"
  ],
  "category": "RuleCategory::health(\"lactose_intolerance_care\")",
  "sections": [
    {
      "title": "症状识别",
      "method": "symptoms",
      "items": [
        "饮奶后腹胀腹痛",
        "排气增多肠鸣腹泻",
        "多在半小时至两小时出现",
        "症状随摄入量加重"
      ]
    },
    {
      "title": "饮食替代",
      "method": "substitute",
      "items": [
        "选无乳糖牛奶酸奶",
        "酸奶乳糖较低可试",
        "硬质奶酪乳糖少",
        "植物奶替代补钙源"
      ]
    },
    {
      "title": "摄入技巧",
      "method": "intake",
      "items": [
        "少量多次逐渐适应",
        "随餐饮奶减轻反应",
        "避免空腹大量饮奶",
        "可选乳糖酶制剂"
      ]
    },
    {
      "title": "营养补充",
      "method": "nutrition",
      "items": [
        "注意钙质足量摄入",
        "绿叶豆制品可补钙",
        "必要时补充维生素D",
        "生长发育期尤为重视"
      ]
    }
  ]
}
