{
  "cat": "health",
  "file": "indigestion_care",
  "struct": "IndigestionCareRules",
  "name": "消化不良调理",
  "desc": "餐后上腹饱胀不适的饮食与生活习惯调理",
  "origin": "中国",
  "tags": [
    "消化",
    "饮食",
    "调理"
  ],
  "category": "RuleCategory::health(\"indigestion_care\")",
  "sections": [
    {
      "title": "饮食调整",
      "method": "diet",
      "items": [
        "少食多餐减轻胃负担",
        "细嚼慢咽每口多嚼",
        "避免油腻辛辣生冷",
        "饭后不宜立即躺卧"
      ]
    },
    {
      "title": "进食习惯",
      "method": "habits",
      "items": [
        "定时定量规律三餐",
        "进餐时心情放松",
        "勿边走边吃边说话",
        "戒烟限酒减少刺激"
      ]
    },
    {
      "title": "生活调理",
      "method": "lifestyle",
      "items": [
        "餐后缓步走动助消化",
        "避免餐后剧烈运动",
        "规律作息减轻压力",
        "腹部保暖避免受凉"
      ]
    },
    {
      "title": "何时就医",
      "method": "seeking_help",
      "items": [
        "持续数周不缓解就医",
        "体重下降须警惕",
        "黑便呕血立即就诊",
        "夜间痛醒应查因"
      ]
    }
  ]
}
