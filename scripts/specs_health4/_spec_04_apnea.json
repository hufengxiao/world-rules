{
  "cat": "health",
  "file": "sleep_apnea",
  "struct": "SleepApneaRules",
  "name": "睡眠呼吸暂停",
  "desc": "打鼾与睡眠呼吸暂停的识别、干预与就医规则",
  "tags": ["健康", "睡眠", "呼吸", "打鼾", "呼吸暂停"],
  "category": "RuleCategory::health(\"sleep_apnea\")",
  "sections": [
    {
      "title": "症状识别",
      "method": "symptoms",
      "items": [
        "响亮的打鼾伴间歇性憋气留意",
        "醒来口干或头痛留意",
        "白天嗜睡影响专注要评估",
        "晨起疲惫却已睡足应就诊"
      ]
    },
    {
      "title": "生活方式",
      "method": "lifestyle",
      "items": [
        "肥胖者减重有助于改善",
        "避免仰睡采用侧卧",
        "睡前避免饮酒与安眠药",
        "规律作息保证睡眠"
      ]
    },
    {
      "title": "干预治疗",
      "method": "treatment",
      "items": [
        "就医进行睡眠监测评估",
        "遵医嘱考虑持续气道正压治疗",
        "纠正气道相关咽倾斜问题",
        "不自行滥用促醒药物"
      ]
    },
    {
      "title": "就医提示",
      "method": "seek_care",
      "items": [
        "常伴高血压者同步评估",
        "晨起头痛心慌可考虑监测",
        "儿童打鼾也建议评估",
        "呼吸暂停明显伴闷醒就医"
      ]
    }
  ]
}