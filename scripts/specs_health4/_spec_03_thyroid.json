{
  "cat": "health",
  "file": "thyroid_care",
  "struct": "ThyroidCareRules",
  "name": "甲状腺健康管理",
  "desc": "甲状腺疾病的早期识别、饮食与随诊规则",
  "tags": ["健康", "甲状腺", "内分泌", "慢病", "随诊"],
  "category": "RuleCategory::health(\"thyroid_care\")",
  "sections": [
    {
      "title": "症状识别",
      "method": "symptoms",
      "items": [
        "持续疲劳、体重变化需留意",
        "心悸、怕冷或怕热异常留意",
        "颈部发现肿块或不适需就医",
        "情绪波动与代谢异常并存时评估"
      ]
    },
    {
      "title": "饮食注意",
      "method": "diet",
      "items": [
        "甲状腺功能异常者规律饮食",
        "碘摄入遵从医嘱适量",
        "均衡营养素支持代谢",
        "避免过度摄入刺激性食物"
      ]
    },
    {
      "title": "随诊用药",
      "method": "followup",
      "items": [
        "遵医嘱规律服用甲状腺药物",
        "不随意自行增减剂量",
        "定期复查甲功",
        "副作用或不适及时沟通医生"
      ]
    },
    {
      "title": "生活方式",
      "method": "lifestyle",
      "items": [
        "保持规律作息减少压力",
        "适度运动控制体重",
        "禁烟限酒利于内分泌",
        "怀孕或备孕者主动评估甲状腺"
      ]
    }
  ]
}