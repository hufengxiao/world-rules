{
  "cat": "social",
  "file": "study_group_etiquette",
  "struct": "StudyGroupEtiquetteRules",
  "name": "学习小组礼仪",
  "desc": "参与学习小组或读书会时的相处规则，包括守时、分工、发言分寸与互相尊重，让共同学习高效又愉快。",
  "origin": "校园与职场学习社群中的常见协作场景",
  "tags": [
    "社交",
    "学习",
    "协作",
    "礼仪"
  ],
  "category": "RuleCategory::social(\"study_group\")",
  "sections": [
    {
      "title": "基本守则",
      "method": "basics",
      "items": [
        "按时参加不无故缺席",
        "提前完成分派的任务",
        "缺席须提前告知",
        "保持学习环境安静整洁"
      ]
    },
    {
      "title": "讨论发言",
      "method": "discussion",
      "items": [
        "轮流发言不打断他人",
        "就事论事不带情绪",
        "不懂就问也乐于解答",
        "尊重不同观点"
      ]
    },
    {
      "title": "分工协作",
      "method": "cooperation",
      "items": [
        "主动承担力所能及的部分",
        "按时交付不拖累整体",
        "需要帮助时及时求助",
        "成果共享不独占"
      ]
    },
    {
      "title": "相处分寸",
      "method": "manner",
      "items": [
        "不贬低他人水平",
        "不炫耀也不自卑",
        "闲聊适度不跑题太久",
        "散会时致谢道别"
      ]
    }
  ]
}