{
  "cat": "social",
  "file": "escape_room_manner",
  "struct": "EscapeRoomMannerRules",
  "name": "密室逃脱协作礼仪",
  "desc": "参与密室逃脱游戏时的团队协作与礼仪规则，包括听从规则、分工配合、尊重队友与爱护道具，提升共同体验。",
  "origin": "现代都市娱乐活动中的团队游戏场景",
  "tags": [
    "社交",
    "娱乐",
    "协作",
    "礼仪"
  ],
  "category": "RuleCategory::social(\"escape_room\")",
  "sections": [
    {
      "title": "入场守则",
      "method": "entry",
      "items": [
        "认真听工作人员讲解规则",
        "按时到场不迟到拖延",
        "妥善存放随身贵重物品",
        "不携带违禁或危险物品"
      ]
    },
    {
      "title": "团队协作",
      "method": "teamwork",
      "items": [
        "合理分工各司其职",
        "及时分享发现的线索",
        "不独断也不袖手旁观",
        "遇分歧快速沟通定夺"
      ]
    },
    {
      "title": "尊重队友",
      "method": "respect",
      "items": [
        "不埋怨出错的人",
        "照顾胆小的队友",
        "不抢功也不甩锅",
        "鼓励为主营造氛围"
      ]
    },
    {
      "title": "道具与安全",
      "method": "safety",
      "items": [
        "轻拿轻放机关道具",
        "不暴力破坏设备",
        "遵守安全提示不冒险",
        "结束后归位并道谢"
      ]
    }
  ]
}