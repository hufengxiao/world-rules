{
  "cat": "social",
  "file": "remote_meeting_etiquette",
  "struct": "RemoteMeetingEtiquetteRules",
  "name": "远程会议礼仪",
  "desc": "线上视频会议中的设备、发言与互动规范",
  "origin": "职场通用",
  "tags": [
    "职场",
    "线上",
    "会议"
  ],
  "category": "RuleCategory::social(\"remote_meeting_etiquette\")",
  "sections": [
    {
      "title": "会前准备",
      "method": "preparation",
      "items": [
        "提前测试音视频设备",
        "选安静整洁的背景",
        "备好资料准时入会",
        "修改显示名为真实姓名"
      ]
    },
    {
      "title": "发言规范",
      "method": "speaking",
      "items": [
        "非发言时静音",
        "发言前先示意再开口",
        "一次一人避免抢话",
        "语速平稳吐字清晰"
      ]
    },
    {
      "title": "镜头礼仪",
      "method": "camera",
      "items": [
        "按约定开启摄像头",
        "正视镜头保持专注",
        "避免边吃边开会",
        "不做引人分心的动作"
      ]
    },
    {
      "title": "互动秩序",
      "method": "interaction",
      "items": [
        "用举手或聊天区示意",
        "重要结论打字记录",
        "不私聊刷屏干扰",
        "会后整理行动项"
      ]
    }
  ]
}
