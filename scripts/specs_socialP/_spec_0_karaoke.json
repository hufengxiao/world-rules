  ],
  "category": "RuleCategory::social(\"karaoke\")",
  "sections": [
    {
      "title": "点歌秩序",
      "method": "ordering",
      "items": [
        "轮流点歌不霸占歌单",
        "顾及他人喜好搭配曲目",
        "不反复插播同一首歌",
        "给每人留出演唱机会"
      ]
    },
    {
      "title": "演唱礼节",
      "method": "singing",
      "items": [
        "麦克风用完递给下一位",
        "不抢麦不压他人声",
        "音量适中不嘶吼",
        "唱错也不嘲笑起哄"
      ]
    },
    {
      "title": "捧场互动",
      "method": "support",
      "items": [
        "认真听他人演唱",
        "适时鼓掌喝彩",
        "可轻声合唱但不喧宾夺主",
        "不低头玩手机冷场"
      ]
    },
    {
      "title": "公共分寸",
      "method": "manner",
      "items": [
        "控制音量不扰邻包",
        "爱护设备不乱摔麦克风",
        "饮食注意不弄脏包厢",
        "结束时整理随身物品"
      ]
    }
  ]
}