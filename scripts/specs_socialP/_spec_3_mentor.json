{
  "cat": "social",
  "file": "mentor_mentee_etiquette",
  "struct": "MentorMenteeEtiquetteRules",
  "name": "师徒相处礼仪",
  "desc": "职场带教关系中导师与新人相处的分寸与礼节",
  "origin": "职场通用",
  "tags": [
    "职场",
    "带教",
    "关系"
  ],
  "category": "RuleCategory::social(\"mentor_mentee_etiquette\")",
  "sections": [
    {
      "title": "导师之责",
      "method": "mentor_duty",
      "items": [
        "耐心指导不摆架子",
        "给予试错空间与鼓励",
        "因材施教循序渐进",
        "及时反馈不秋后算账"
      ]
    },
    {
      "title": "新人之礼",
      "method": "mentee_courtesy",
      "items": [
        "主动请教虚心受教",
        "独立思考后再提问",
        "尊重导师时间与安排",
        "受助后真诚致谢"
      ]
    },
    {
      "title": "沟通方式",
      "method": "communication",
      "items": [
        "约定固定的沟通节奏",
        "提问先自行查证",
        "反馈对事不对人",
        "不传八卦不越级抱怨"
      ]
    },
    {
      "title": "边界把握",
      "method": "boundary",
      "items": [
        "公私分明不过度依附",
        "导师不越权分配私活",
        "新人应独立承担责任",
        "关系平等相互尊重"
      ]
    }
  ]
}
