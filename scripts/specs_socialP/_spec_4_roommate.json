{
  "cat": "social",
  "file": "roommate_living_manner",
  "struct": "RoommateLivingMannerRules",
  "name": "合租室友相处礼仪",
  "desc": "与室友共同居住的相处规则，包括公共区域卫生、噪音控制、物品借用与费用分摊，维持和谐共居关系。",
  "origin": "城市合租生活中的常见共居场景",
  "tags": [
    "社交",
    "生活",
    "共居",
    "礼仪"
  ],
  "category": "RuleCategory::social(\"roommate\")",
  "sections": [
    {
      "title": "公共区域",
      "method": "shared_space",
      "items": [
        "用完公共区域及时清理",
        "厨房油污随手擦净",
        "卫生间保持干燥整洁",
        "垃圾按轮值及时清倒"
      ]
    },
    {
      "title": "作息噪音",
      "method": "noise",
      "items": [
        "夜间控制说话与音量",
        "戴耳机看视频听音乐",
        "轻关门窗不甩门",
        "早出晚归尽量放轻脚步"
      ]
    },
    {
      "title": "物品与费用",
      "method": "belongings",
      "items": [
        "借用他人物品先征得同意",
        "及时归还并保持完好",
        "水电燃气按约定分摊",
        "私人食物不擅自取用"
      ]
    },
    {
      "title": "沟通分寸",
      "method": "communication",
      "items": [
        "有问题及时平和沟通",
        "不当面不说背后议论",
        "尊重彼此隐私与空间",
        "重大变动提前商量"
      ]
    }
  ]
}