        "早餐不省略营养充足",
        "晚上减少过饱进食"
      ]
    },
    {
      "title": "控量原则",
      "method": "portion",
      "items": [
        "使用适量份量进餐",
        "限制油脂糖与盐",
        "减少含糖饮料",
        "注重咀嚼细嚼慢咽"
      ]
    },
    {
      "title": "顺应个体",
      "method": "individual",
      "items": [
        "依据年龄活动量调整",
        "特殊人群遵医嘱安排",
        "结合文化饮食习惯",
        "可持续坚持避免短期极端"
      ]
    }
  ]
