      "items": [
        "赢球不炫耀奚落",
        "输球不找借口抱怨",
        "尊重对手努力",
        "庆祝有节制有分寸"
      ]
    },
    {
      "title": "尊重对手",
      "method": "respect",
      "items": [
        "赛前赛后握手致意",
        "不与对手发生肢体冲突",
