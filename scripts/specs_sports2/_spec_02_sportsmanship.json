        "诚实面对判罚",
        "维护比赛公平公正"
      ]
    },
    {
      "title": "团队情谊",
      "method": "team",
      "items": [
        "鼓励发挥欠佳的同伴",
        "失利不指责队友",
        "共享荣誉也共担责任",
        "尊重教练与团队"
      ]
    }
