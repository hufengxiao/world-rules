{
  "cat": "games",
  "file": "set_card_matching",
  "struct": "SetCardMatchingRules",
  "name": "SET 卡片游戏",
  "desc": "SET 是一种考验观察力的卡片游戏，玩家需从桌面卡牌中找出三张在颜色、形状、数量、填充四个属性上「全同或全不同」的牌组成一组。",
  "origin": "由遗传学家 Marsha Falco 于1974年发明",
  "tags": [
    "卡牌",
    "观察",
    "匹配",
    "桌面游戏"
  ],
  "category": "RuleCategory::games(\"set_card\")",
  "sections": [
    {
      "title": "卡牌属性",
      "method": "cards",
      "items": [
        "每张牌有四个独立属性",
        "颜色分红绿紫三色",
        "形状分菱形波浪椭圆",
        "数量为一到三个且填充分实心空心条纹"
      ]
    },
    {
      "title": "成组条件",
      "method": "matching",
      "items": [
        "三张牌每一属性须全同或全不同",
        "四个属性须同时满足条件",
        "任意两两组合不得部分相同",
        "符合条件的三张即为一组"
      ]
    },
    {
      "title": "游戏流程",
      "method": "play",
      "items": [
        "桌面摆出十二张明牌",
        "玩家找出并喊出SET组合",
        "确认后取走该组牌",
        "从牌堆补足桌面牌数"
      ]
    },
    {
      "title": "计分与结束",
      "method": "scoring",
      "items": [
        "每找出一组得一分",
        "找错组须扣分或暂停",
        "牌堆用尽且桌面无解时结束",
        "得分最高者获胜"
      ]
    }
  ]
}