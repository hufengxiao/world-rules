    {
      "title": "棋盘准备",
      "method": "setup",
      "items": [
        "纸上画点阵方阵",
        "常用五点见方或更大",
        "相邻点间可连线",
        "线须落在点与点之间"
      ]
    },
    {
      "title": "轮流画线",
      "method": "drawing",
      "items": [
        "每回合连接相邻两点",
