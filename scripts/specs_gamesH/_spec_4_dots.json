        "不得画对角线"
      ]
    },
    {
      "title": "围格得分",
      "method": "scoring",
      "items": [
        "补齐方格第四条边即得该格",
        "得格者在格内写下标记",
        "得格后可立即再画一线",
        "连围多格可连续行动"
      ]
    },
    {
      "title": "策略要领",
      "method": "strategy",
      "items": [
        "避免给对手留下第三边",
        "链条式围格可一气呵成",
        "牺牲小格换取主动权",
        "残局须精确计算得失"
      ]
    },
    {
      "title": "胜负结束",
      "method": "ending",
      "items": [
        "所有方格围满即终局",
        "统计各自占据的方格数",
        "方格多者获胜",
        "同数则平局"
      ]
    }
  ]
