    "策略"
  ],
  "category": "RuleCategory::games(\"nim_game\")",
  "sections": [
    {
      "title": "开局摆法",
      "method": "setup",
      "items": [
        "摆出若干堆火柴或棋子",
        "各堆数量可相同可不同",
        "约定取走最后者胜负",
        "常见三堆三五七枚"
      ]
    },
    {
      "title": "取子规则",
      "method": "taking",
      "items": [
        "每次只从一堆中取子",
        "可取一枚或多枚",
        "可一次取光整堆",
        "不得跨堆同时取"
      ]
    },
    {
      "title": "胜负判定",
      "method": "winning",
      "items": [
        "取走最后一件者胜",
        "或约定取最后者输",
        "胜负约定须开局定明",
        "中途不可更改"
      ]
    },
    {
      "title": "必胜策略",
      "method": "strategy",
      "items": [
        "各堆数量按二进制异或",
        "异或为零为必败局面",
        "每次取子令异或归零",
        "对手失误即可反制"
      ]
    },
    {
      "title": "公平博弈",
      "method": "fairness",
      "items": [
        "完全信息无随机因素",
        "先手在多数局面占优",
        "双方均按最优应对",
        "属组合博弈论典范"
      ]
    }
  ]
