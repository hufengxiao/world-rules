{
  "cat": "law",
  "file": "labor_contract_write",
  "struct": "LaborContractWriteRules",
  "name": "劳动合同要点",
  "desc": "劳动合同的订立、内容与续签要点",
  "origin": "中国",
  "tags": ["法律", "劳动合同", "劳动"],
  "category": "RuleCategory::law(\"labor_contract\")",
  "sections": [
    {
      "title": "合同订立",
      "method": "sign",
      "items": [
        "入职即订立合同",
        "双方主体明确",
        "书面合同留存",
        "不签空白合同"
      ]
    },
    {
      "title": "内容要素",
      "method": "content",
      "items": [
        "载明岗位报酬",
        "明确工时休假",
        "列社保条款",
        "工作地点清楚"
      ]
    },
    {
      "title": "期限与试用",
      "method": "duration",
      "items": [
        "固定期限有约",
        "试用期依法定",
        "合同内容合法",
        "变更需书面"
      ]
    },
    {
      "title": "权益落实",
      "method": "enjoy",
      "items": [
        "保留合同证据",
        "条款违规可主张",
        "查阅社保缴纳",
        "协商调解维权"
      ]
    }
  ]
}