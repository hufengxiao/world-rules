{
  "cat": "health",
  "file": "denture_care_cleaning",
  "struct": "DentureCareCleaningRules",
  "name": "假牙与义齿护理",
  "desc": "假牙清洁保养与戴用舒适的口腔护理方法",
  "origin": "中国",
  "tags": [
    "健康",
    "假牙",
    "义齿",
    "口腔"
  ],
  "category": "RuleCategory::health(\"denture_care\")",
  "sections": [
    {
      "title": "日常清洁",
      "method": "clean",
      "items": [
        "饭后取下冲洗",
        "用软毛刷轻刷",
        "专用清洁剂浸泡",
        "勿用热水烫变形"
      ]
    },
    {
      "title": "佩戴卫生",
      "method": "wear",
      "items": [
        "睡前取下泡水",
        "保持湿润不发干",
        "刷洗口腔余缝",
        "定期复诊调整"
      ]
    },
    {
      "title": "舒适调整",
      "method": "comfort",
      "items": [
        "初戴磨合有不适",
        "改动压迫处",
        "不适明显就医",
        "勿自行打磨"
      ]
    },
    {
      "title": "健康习惯",
      "method": "habit",
      "items": [
        "进食细嚼慢咽",
        "避免过热过硬",
        "留意口腔黏膜",
        "保持口腔卫生"
      ]
    }
  ]
}
