{
  "cat": "law",
  "file": "crowdfunding_legal",
  "struct": "CrowdfundingLegalRules",
  "name": "众筹法律规则",
  "desc": "网络众筹活动的法律规则，包括平台资质、信息披露、资金用途监督与投资者权益保护，规范众筹各方权利义务。",
  "origin": "互联网金融与证券监管相关法规",
  "tags": [
    "法律",
    "金融",
    "众筹",
    "投资"
  ],
  "category": "RuleCategory::law(\"crowdfunding\")",
  "sections": [
    {
      "title": "平台资质",
      "method": "platform",
      "items": [
        "平台须具备合法经营资质",
        "履行项目审核义务",
        "建立风险提示机制",
        "妥善保管投资者资金"
      ]
    },
    {
      "title": "信息披露",
      "method": "disclosure",
      "items": [
        "发起人须如实披露项目信息",
        "不得虚假宣传或夸大收益",
        "明确资金用途与风险",
        "及时公布进展与结果"
      ]
    },
    {
      "title": "资金管理",
      "method": "funding",
      "items": [
        "募集资金专款专用",
        "达不成目标须按约退款",
        "变更用途须经同意",
        "接受监督与审计"
      ]
    },
    {
      "title": "权益与救济",
      "method": "rights",
      "items": [
        "投资者享有知情权",
        "遇欺诈可依法索赔",
        "涉嫌非法集资依法处理",
        "纠纷可投诉或诉讼"
      ]
    }
  ]
}