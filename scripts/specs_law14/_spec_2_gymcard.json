{
  "cat": "law",
  "file": "gym_membership_contract",
  "struct": "GymMembershipContractRules",
  "name": "健身卡合同规则",
  "desc": "健身房会员卡消费的法律规则，包括合同签订、预付卡风险、退卡转让与商家违约救济，保护消费者合法权益。",
  "origin": "预付式消费与消费者权益保护法规",
  "tags": [
    "法律",
    "消费",
    "预付卡",
    "健身"
  ],
  "category": "RuleCategory::law(\"gym_membership\")",
  "sections": [
    {
      "title": "合同签订",
      "method": "contract",
      "items": [
        "签订书面服务合同",
        "明确服务内容与期限",
        "留意格式条款中的免责内容",
        "保留合同与付款凭证"
      ]
    },
    {
      "title": "预付风险",
      "method": "prepaid",
      "items": [
        "警惕超低价长期卡诱导",
        "预付金额不宜过大",
        "了解退费规则",
        "关注商家经营状况"
      ]
    },
    {
      "title": "退卡转让",
      "method": "refund",
      "items": [
        "合理原因可申请退卡",
        "退费按剩余期限折算",
        "转让须符合约定程序",
        "商家不得设不合理障碍"
      ]
    },
    {
      "title": "违约救济",
      "method": "remedy",
      "items": [
        "商家关店跑路可投诉",
        "可向消协或市场监管举报",
        "协商不成可提起诉讼",
        "涉嫌诈骗可报警处理"
      ]
    }
  ]
}