{
  "cat": "law",
  "file": "short_video_copyright_law",
  "struct": "ShortVideoCopyrightLawRules",
  "name": "短视频版权",
  "desc": "短视频创作与传播中的著作权使用与侵权边界",
  "origin": "中国",
  "tags": [
    "法律",
    "版权",
    "短视频"
  ],
  "category": "RuleCategory::law(\"short_video_copyright_law\")",
  "sections": [
    {
      "title": "权利归属",
      "method": "ownership",
      "items": [
        "原创视频享著作权",
        "拍摄者享相关权利",
        "音乐画面需授权",
        "职务作品依约定"
      ]
    },
    {
      "title": "合理使用",
      "method": "fair_use",
      "items": [
        "适当引用可构成合理使用",
        "评论说明为目的",
        "不得影响原作正常使用",
        "不得损害权利人利益"
      ]
    },
    {
      "title": "常见侵权",
      "method": "infringement",
      "items": [
        "搬运他人视频",
        "擅自使用背景音乐",
        "二次剪辑商用",
        "盗用他人素材"
      ]
    },
    {
      "title": "维权方式",
      "method": "remedy",
      "items": [
        "通知平台下架删除",
        "要求赔偿损失",
        "保留原创证据",
        "必要时提起诉讼"
      ]
    }
  ]
}
