      "method": "agreement",
      "items": [
        "交易双方与监管方签订书面协议",
        "明确监管金额与用途",
        "约定划转条件与时限",
        "约定违约责任"
      ]
    },
    {
      "title": "资金划转",
      "method": "transfer",
