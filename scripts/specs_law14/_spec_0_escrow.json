        "核实监管账户真实有效",
        "警惕私下划款要求",
        "留存全部交易凭证"
      ]
    },
    {
      "title": "争议处理",
      "method": "dispute",
      "items": [
        "划转争议按协议协商",
        "协商不成可诉诸法院",
        "监管方失职可追责",
        "保全证据便于维权"
      ]
    }
  ]
