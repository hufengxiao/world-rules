{
  "cat": "law",
  "file": "live_commerce_law",
  "struct": "LiveCommerceLawRules",
  "name": "直播带货法律",
  "desc": "直播销售中主播、商家与平台的法律责任",
  "origin": "中国",
  "tags": [
    "法律",
    "电商",
    "直播"
  ],
  "category": "RuleCategory::law(\"live_commerce_law\")",
  "sections": [
    {
      "title": "主体责任",
      "method": "liability",
      "items": [
        "商家对商品质量负责",
        "主播虚假宣传须担责",
        "平台负审核管理义务",
        "广告代言人亦担责"
      ]
    },
    {
      "title": "宣传规范",
      "method": "advertising",
      "items": [
        "不得虚假夸大宣传",
        "禁用绝对化用语",
        "数据销量须真实",
        "医疗保健特殊监管"
      ]
    },
    {
      "title": "消费者权利",
      "method": "consumer_rights",
      "items": [
        "享七日无理由退货",
        "质量问题可要求赔偿",
        "虚假宣传可主张三倍赔",
        "保留直播录屏为证"
      ]
    },
    {
      "title": "维权途径",
      "method": "remedy",
      "items": [
        "先与商家协商退换",
        "向平台投诉举报",
        "拨打一二三一五投诉",
        "必要时提起诉讼"
      ]
    }
  ]
}
