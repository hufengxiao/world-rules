{
  "cat": "law",
  "file": "car_repair_dispute",
  "struct": "CarRepairDisputeRules",
  "name": "汽车维修纠纷",
  "desc": "汽车维修保养纠纷的法律规则，包括维修合同、配件质量、费用争议与索赔途径，维护车主合法权益。",
  "origin": "消费者权益保护与汽车维修行业管理规定",
  "tags": [
    "法律",
    "消费",
    "汽车",
    "维修"
  ],
  "category": "RuleCategory::law(\"car_repair\")",
  "sections": [
    {
      "title": "维修合同",
      "method": "contract",
      "items": [
        "维修前确认项目与报价",
        "要求出具书面维修单",
        "明确配件来源与质保期",
        "变更项目须经同意"
      ]
    },
    {
      "title": "配件质量",
      "method": "parts",
      "items": [
        "原厂件与副厂件须明示",
        "不得以次充好以旧充新",
        "保留更换下的旧件",
        "配件质量问题可追责"
      ]
    },
    {
      "title": "费用争议",
      "method": "fee",
      "items": [
        "维修费须事先告知",
        "不得擅自增加收费项目",
        "索要正规发票",
        "对收费有异议先协商"
      ]
    },
    {
      "title": "索赔途径",
      "method": "claim",
      "items": [
        "维修不当致损可要求赔偿",
        "向消协或运管部门投诉",
        "鉴定损失作为证据",
        "协商不成可诉至法院"
      ]
    }
  ]
}