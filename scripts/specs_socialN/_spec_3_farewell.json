  "category": "RuleCategory::social(\"farewell_leaving\")",
  "sections": [
    {
      "title": "告辞时机",
      "method": "timing",
      "items": [
        "尽兴时告辞最好",
        "不在高潮中途走",
        "必要先走先致意",
        "别拖泥带水"
      ]
    },
    {
      "title": "礼貌告别",
      "method": "wording",
      "items": [
        "向主人当面辞行",
        "说明离开原因",
        "感谢款待",
        "不出人意而别"
      ]
    },
    {
      "title": "先辞开幅",
      "method": "host",
      "items": [
        "先跟主持人辞",
        "慢慢与其他宾客",
        "不惊动全场",
        "挥手致意即可"
      ]
    },
    {
      "title": "离后续礼",
      "method": "after",
      "items": [
        "到家报个平安",
        "发消息再谢一次",
        "途中注意安全",
        "改日再聚作为回谢"
      ]
    }
  ]
